# ──────────────────────────────────────────────────────────────────────
#  Glimmora Lawyer · Frontend env
# ──────────────────────────────────────────────────────────────────────
#
#  Copy to `.env.local` for local development. For Vercel, set the same
#  variables under Project Settings → Environment Variables (Production,
#  Preview, Development).
#
#  All `NEXT_PUBLIC_*` values are baked into the client bundle at build
#  time. Never put secrets here.

# Backend base URL for the FastAPI shim.
#   Local dev:  http://localhost:8000
#   Prod:       https://api.your-domain.com
#
# IMPORTANT for Vercel: this must be an HTTPS origin in production, and
# the backend's `Set-Cookie` for `glimmora_session` must include
# `SameSite=None; Secure` (cross-origin) OR you must host the backend on
# the same parent domain so cookies are first-party.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
